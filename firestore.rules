rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 공개 상품은 노출 상태이며 삭제되지 않은 문서만 조회할 수 있습니다.
    // 생성·수정·재고 변경은 관리자 Cloud Function에서만 수행합니다.
    match /products/{productId} {
      allow read: if isAdmin()
        || (resource.data.isVisible == true && resource.data.isDeleted == false);
      allow write: if false;
    }

    // 주문 생성·결제·상태 변경은 금액/권한 검증을 위해 Cloud Function만 허용합니다.
    match /orders/{orderId} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.customer.uid == request.auth.uid);
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.customer.uid == request.auth.uid);
      allow write: if false;
    }

    // 사용자는 본인 프로필만 관리할 수 있으며 권한 관련 필드는 저장할 수 없습니다.
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'admin',
          'role',
          'roles',
          'customClaims'
        ]);
      allow delete: if false;
    }

    // 상품 데이터 이전 여부만 공개합니다.
    match /settings/storefront {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // 그 외 설정 및 운영 데이터는 관리자만 읽고, 변경은 Cloud Function으로 제한합니다.
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /inventoryLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /productCodes/{codeId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orderCounters/{counterId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /orderRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stats/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailyStats/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /productStats/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailyProductStats/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /testStats/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /testDailyStats/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /testProductStats/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /testDailyProductStats/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Custom Claims가 유일한 관리자 권한 원본입니다.
    match /admins/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
